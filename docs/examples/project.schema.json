                  },
                  "required": [
                    "id",
                    "title",
                    "order",
                    "text",
                    "evidence_ids"
                  ]
                },
                "maxItems": 200
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "scene_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "department": {
                      "enum": [
                        "light",
                        "sound",
                        "stage",
                        "performer"
                      ]
                    },
                    "trigger": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "instruction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "requires_ids": {
                      "type": "array",
                      "items": {
