    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_kind": {
            "enum": [
              "scene",
              "cue",
              "plan"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
