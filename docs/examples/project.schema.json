                          "maxLength": 100
                        },
                        "order": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 300
                        },
                        "cue_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "hold_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3600000
                        }
                      },
                      "required": [
                        "id",
                        "order",
                        "cue_id",
                        "hold_ms"
                      ]
                    },
                    "maxItems": 300
                  },
                  "basis_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
