              "required": [
                "occurrence_id",
                "at_ms",
                "result",
                "comment"
              ]
            },
            "maxItems": 300
          },
          "declaration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "plan_id",
          "basis_sha256",
          "snapshot",
          "outcomes",
          "declaration"
        ]
      },
      "maxItems": 20
