{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 170
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "byte_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "source_index",
          "byte_start",
          "byte_end",
          "quote",
          "attribution"
        ]
      },
      "maxItems": 200
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 24000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "text",
          "evidence_ids"
        ]
      },
      "maxItems": 100
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "department": {
            "enum": [
              "light",
              "sound",
              "stage",
              "performer"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "requires_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 30
          },
          "estimate_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "scene_id",
          "title",
          "department",
          "trigger",
          "instruction",
          "requires_ids",
          "estimate_ms"
        ]
      },
      "maxItems": 200
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "cue_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "hold_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                }
              },
              "required": [
                "id",
                "order",
                "cue_id",
                "hold_ms"
              ]
            },
            "maxItems": 300
          },
          "basis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "items",
          "basis_sha256",
          "rationale"
        ]
      },
      "maxItems": 40
    },
