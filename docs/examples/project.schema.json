            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 300
                    },
                    "text": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 24000
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "maxItems": 50
